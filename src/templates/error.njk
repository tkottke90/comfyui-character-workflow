{% extends "layout.njk" %}
{% block content %}
  <div class="max-w-lg">
    <div class="text-[13.5px] font-mono text-steel-400 mb-2">Error {{ status }}</div>
    <h1 class="text-2xl font-black tracking-tight mb-3">
      {% if status == 404 %}Not found{% else %}Something went wrong{% endif %}
    </h1>
    <p class="text-steel-600 dark:text-steel-300 mb-6">{{ message }}</p>
    <a href="/characters" class="inline-flex items-center rounded-md px-4 py-2 text-[14px] font-semibold bg-apple-600 hover:bg-apple-700 text-white">
      Back to Characters
    </a>
  </div>
{% endblock %}
