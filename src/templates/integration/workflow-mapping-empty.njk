{% extends "layout.njk" %}
{% set section = "integration" %}
{% set subsection = "workflow-mapping" %}
{% import "macros.njk" as ui %}
{% block content %}
  {{ ui.crumbs([{label: 'Integration', href: '/integration/connection'}, {label: 'Workflow Mapping'}]) }}
  {% include "partials/integration-subnav.njk" %}

  <div class="flex items-center gap-3 mb-6 bg-white dark:bg-steel-900 border border-steel-200 dark:border-steel-800 rounded-lg shadow-sm px-4 py-3">
    <span class="text-[13px] font-bold text-steel-600 dark:text-steel-300 whitespace-nowrap">
      {{ progress.configured }} of {{ progress.total }} required workflows configured
    </span>
    <div class="flex-1 h-2 rounded-full bg-steel-100 dark:bg-steel-800 overflow-hidden">
      <div class="h-full bg-steel-400 dark:bg-steel-500" style="width: {{ (progress.configured / progress.total * 100) if progress.total else 0 }}%"></div>
    </div>
    <span class="font-mono text-[11.5px] text-steel-400 whitespace-nowrap">999-DualFaceID optional</span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-[230px_1fr] gap-5 items-start">
    <div class="flex flex-col gap-4">
      {% call ui.card('Phase bindings') %}
        {% for row in phaseBindings %}
          <div class="py-1.5 border-b border-steel-200 dark:border-steel-800 last:border-0">
            <div class="font-bold text-[12.5px]">{{ row.label }}</div>
            <div class="font-mono text-[12.5px] text-steel-400">— not configured —</div>
          </div>
        {% endfor %}
      {% endcall %}

      {% call ui.card('Imported workflows') %}
        <p class="text-[12.5px] text-steel-400 text-center py-2">
          No workflows imported yet.<br>Versions will appear here once you import your first .json export.
        </p>
      {% endcall %}
    </div>

    <div class="flex flex-col items-center justify-center text-center bg-white dark:bg-steel-900 border-2 border-dashed border-steel-300 dark:border-steel-700 rounded-xl p-14 min-h-[420px]">
      <div class="h-14 w-14 rounded-full bg-steel-100 dark:bg-steel-800 flex items-center justify-center text-steel-400 mb-5">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" />
          <path d="M14 2v6h6" />
          <path d="M12 18v-6" />
          <path d="M9 15h6" />
        </svg>
      </div>
      <h1 class="text-lg font-black mb-2">No workflows imported yet</h1>
      <p class="text-[13.5px] text-steel-500 max-w-md mb-5">
        Nothing is bound to any phase on a fresh install. Import an exact JSON export of a ComfyUI
        workflow to configure its field mappings and bind it to a phase — {{ requiredSlots.length }}
        required workflows, plus one optional diagnostic workflow.
      </p>

      <form method="post" action="/integration/workflow-mapping/import" data-file-upload class="mb-7">
        <input type="hidden" name="workflowJsonDataUrl" value="" />
        <input type="hidden" name="filename" data-file-name value="" />
        <div class="rounded-lg border-2 border-dashed border-steel-300 dark:border-steel-700 px-10 py-6 flex flex-col items-center gap-2 cursor-pointer mb-3"
             onclick="this.querySelector('input[type=file]').click()">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-steel-400">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="17 8 12 3 7 8" />
            <line x1="12" y1="3" x2="12" y2="15" />
          </svg>
          <div class="text-[13px] font-semibold" data-file-label>Drag a workflow .json here, or click to browse</div>
          <input type="file" accept="application/json" class="hidden" />
        </div>
        {{ ui.button('Import workflow (.json)') }}
      </form>

      <div class="pt-5 border-t border-steel-200 dark:border-steel-800 w-full max-w-md">
        <div class="text-[11px] font-bold uppercase tracking-wider text-steel-400 mb-2.5">Required for Character List to unlock</div>
        <div class="flex flex-wrap gap-1.5 justify-center">
          {% for slot in allSlots %}
            <span class="font-mono text-[11px] font-semibold {{ 'text-steel-500 dark:text-steel-400' if slot.required else 'text-steel-400 dark:text-steel-600 italic' }} bg-steel-100 dark:bg-steel-800 border border-steel-200 dark:border-steel-700 rounded px-2 py-0.5">
              {{ slot.id }}{{ ' (optional)' if not slot.required }}
            </span>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
{% endblock %}
