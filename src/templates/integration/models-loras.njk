{% extends "layout.njk" %}
{% set section = "integration" %}
{% set subsection = "models-loras" %}
{% import "macros.njk" as ui %}
{% block content %}
  {{ ui.crumbs([{label: 'Integration', href: '/integration/connection'}, {label: 'Models & LoRAs'}]) }}
  {% include "partials/integration-subnav.njk" %}

  <div class="flex items-center gap-3 mb-1">
    <h1 class="text-xl font-black tracking-tight">Models &amp; LoRAs</h1>
    <a href="/integration/models-loras" class="ml-auto rounded-md border border-steel-300 dark:border-steel-700 px-3.5 py-1.5 text-[12.5px] font-bold text-steel-600 dark:text-steel-200 hover:bg-steel-50 dark:hover:bg-steel-800">
      Refresh from ComfyUI
    </a>
  </div>

  {% if syncError %}
    <p class="text-[12.5px] text-rose-700 dark:text-rose-300 mb-6">Could not reach ComfyUI: {{ syncError }} — showing what's currently referenced by active workflow versions only.</p>
  {% else %}
    <p class="text-[12.5px] text-steel-400 mb-6">Synced live via /object_info · new files won't appear here until ComfyUI itself has been restarted since they were added.</p>
  {% endif %}

  {% for group in groups %}
    <div class="mb-5">
      <div class="text-[12px] font-bold uppercase tracking-wider text-steel-500 dark:text-steel-400 mb-2 flex items-center gap-2">
        {{ group.title }}
        <span class="font-normal text-steel-400 normal-case tracking-normal">({{ group.rows.length }})</span>
      </div>

      {% if not group.rows.length %}
        <p class="text-[12.5px] text-steel-400 italic">Nothing found for this category.</p>
      {% else %}
        <div class="bg-white dark:bg-steel-900 border border-steel-200 dark:border-steel-800 rounded-lg shadow-sm overflow-hidden">
          <div class="grid grid-cols-[1fr_190px_190px_110px] gap-3 px-4 py-2 bg-steel-100 dark:bg-steel-800 text-[11px] font-bold uppercase tracking-wider text-steel-500 dark:text-steel-400">
            <div>Filename</div><div>Loader</div><div>Used by</div><div>Status</div>
          </div>
          {% for row in group.rows %}
            <div class="grid grid-cols-[1fr_190px_190px_110px] gap-3 items-center px-4 py-2 border-b border-steel-200 dark:border-steel-800 last:border-0 text-[13px] {{ 'text-steel-400' if not row.usedBy.length and row.installed }}">
              <div class="font-mono truncate">{{ row.filename }}</div>
              <div>{{ row.loader }}</div>
              <div>{{ row.usedBy | join(', ') if row.usedBy.length else '—' }}</div>
              <div>
                {% if not row.installed %}
                  {{ ui.pill('missing', 'danger') }}
                {% elif row.usedBy.length %}
                  {{ ui.pill('installed', 'success') }}
                {% else %}
                  {{ ui.pill('not referenced', 'neutral') }}
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  {% endfor %}
{% endblock %}
