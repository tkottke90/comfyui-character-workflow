{% macro statusBadge(status) %}
  {% set label = {
    'draft': 'Draft',
    'casting': 'Casting',
    'locked': 'Locked',
    'kit-complete': 'Kit-complete',
    'lora-trained': 'LoRA-trained'
  } %}
  {% set tone = {
    'draft': 'bg-steel-100 text-steel-600 border-steel-200 dark:bg-steel-800 dark:text-steel-300 dark:border-steel-700',
    'casting': 'bg-steel-100 text-steel-700 border-steel-200 dark:bg-steel-800 dark:text-steel-200 dark:border-steel-700',
    'locked': 'bg-apple-100 text-apple-800 border-apple-300 dark:bg-apple-900 dark:text-apple-200 dark:border-apple-700',
    'kit-complete': 'bg-success-100 text-success-700 border-success-500/30 dark:bg-[#12301e] dark:text-[#7fd0a0]',
    'lora-trained': 'bg-success-100 text-success-700 border-success-500/30 dark:bg-[#12301e] dark:text-[#7fd0a0]'
  } %}
  <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-bold {{ tone[status] }}">{{ label[status] }}</span>
{% endmacro %}

{% macro pill(text, kind='neutral') %}
  {% set tone = {
    'neutral': 'bg-steel-100 text-steel-600 dark:bg-steel-800 dark:text-steel-300',
    'blue': 'bg-steel-100 text-steel-700 dark:bg-steel-800 dark:text-steel-200',
    'green': 'bg-apple-100 text-apple-800 dark:bg-apple-900 dark:text-apple-200',
    'success': 'bg-success-100 text-success-700 dark:bg-[#12301e] dark:text-[#7fd0a0]',
    'danger': 'bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300'
  } %}
  <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-bold {{ tone[kind] }}">{{ text }}</span>
{% endmacro %}

{% macro crumbs(items) %}
  <nav class="text-[13.5px] text-steel-400 mb-4">
    {% for item in items %}
      {%- if not loop.last -%}
        <a href="{{ item.href }}" class="hover:text-steel-600 dark:hover:text-steel-200">{{ item.label }}</a>
        <span class="mx-1.5">&rsaquo;</span>
      {%- else -%}
        <span class="font-semibold text-[#222] dark:text-[#efefef]">{{ item.label }}</span>
      {%- endif -%}
    {% endfor %}
  </nav>
{% endmacro %}

{% macro card(label='') %}
  <div class="bg-white dark:bg-steel-900 border border-steel-200 dark:border-steel-800 rounded-lg shadow-[0_1px_2px_rgba(29,38,52,.06)] p-5">
    {% if label %}
      <div class="text-[11.5px] font-bold uppercase tracking-wider text-steel-500 dark:text-steel-400 mb-3">{{ label }}</div>
    {% endif %}
    {{ caller() }}
  </div>
{% endmacro %}

{% macro copyable(value='', inline=false) %}
  {% set content = caller() %}
  <button type="button"
    data-copy-target="{{ value if value else (content | striptags | trim) }}"
    aria-label="Copy to clipboard"
    class="group relative text-left transition-colors {{ 'inline-flex items-center gap-1.5 align-middle bg-transparent hover:text-steel-600 dark:hover:text-steel-300' if inline else 'flex items-start gap-3 w-full bg-white dark:bg-steel-900 border border-steel-200 dark:border-steel-800 rounded-lg shadow-[0_1px_2px_rgba(29,38,52,.06)] p-3 hover:bg-steel-50 dark:hover:bg-steel-800/50' }}">
    <span class="{{ '' if inline else 'flex-1 min-w-0' }}">{{ content }}</span>
    <span class="copy-icon-wrap shrink-0 {{ '' if inline else 'mt-0.5' }}">
      <svg data-copy-icon="idle" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-steel-400 opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-opacity">
        <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
        <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
      </svg>
      <svg data-copy-icon="success" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-success-700 dark:text-[#7fd0a0]">
        <path d="M20 6 9 17l-5-5" />
      </svg>
    </span>
  </button>
{% endmacro %}

{% macro navTabs(tabs, active, id='subnav', fallbackLabel='Menu') %}
  {% set activeLabel = fallbackLabel %}
  {% for tab in tabs %}
    {% if tab.key == active %}{% set activeLabel = tab.label %}{% endif %}
  {% endfor %}
  <div class="mb-5 border-b border-steel-200 dark:border-steel-800" data-subnav>
    <div class="hidden md:flex gap-1">
      {% for tab in tabs %}
        <a href="{{ tab.href }}"
           class="px-3.5 py-2 text-[13px] font-bold -mb-px border-b-2 transition-colors
                  {{ 'text-apple-800 dark:text-apple-200 border-apple-600' if active == tab.key else 'text-steel-500 border-transparent hover:text-steel-700 dark:hover:text-steel-300' }}">
          {{ tab.label }}
        </a>
      {% endfor %}
    </div>
    <div class="relative md:hidden pb-2">
      <button type="button" data-subnav-trigger aria-haspopup="true" aria-expanded="false" aria-controls="{{ id }}-menu"
        class="flex items-center justify-between w-full gap-2 px-3.5 py-2 text-[13px] font-bold rounded-md border border-steel-200 dark:border-steel-800 text-apple-800 dark:text-apple-200">
        <span>{{ activeLabel }}</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </button>
      <div id="{{ id }}-menu" data-subnav-menu
        class="hidden absolute left-0 right-0 top-full z-10 mt-1 rounded-md border border-steel-200 dark:border-steel-800 bg-white dark:bg-steel-900 shadow-lg overflow-hidden">
        {% for tab in tabs %}
          <a href="{{ tab.href }}"
             class="block px-3.5 py-2 text-[13px] font-bold transition-colors
                    {{ 'text-apple-800 dark:text-apple-200 bg-apple-50 dark:bg-apple-950' if active == tab.key else 'text-steel-500 hover:text-steel-700 dark:hover:text-steel-300 hover:bg-steel-50 dark:hover:bg-steel-800' }}">
            {{ tab.label }}
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
{% endmacro %}

{% macro checkrow(name, checked, label, disabled=false) %}
  <label class="flex items-start gap-2.5 py-1.5 text-[14px] {{ 'opacity-50' if disabled else 'cursor-pointer' }}">
    <input type="checkbox" name="{{ name }}" {% if checked %}checked{% endif %} {% if disabled %}disabled{% endif %}
      class="mt-0.5 h-4 w-4 shrink-0 rounded accent-apple-600" />
    <span class="{{ 'text-steel-400 dark:text-steel-500' if not checked else 'text-[#222] dark:text-[#efefef]' }}">{{ label }}</span>
  </label>
{% endmacro %}

{% macro mono(text) %}<span class="font-mono text-[13px] text-steel-500 dark:text-steel-400">{{ text }}</span>{% endmacro %}

{% macro sourceTypeLabel(sourceType) %}
  {% set label = {
    'unset': 'Unset',
    'domain': 'Domain field',
    'computed': 'Computed',
    'static': 'Static value'
  } %}
  {{- label[sourceType] or sourceType -}}
{% endmacro %}

{% macro mappingStatus(status) %}
  {% set config = {
    'unmapped': {label: '○ not mapped', class: 'text-steel-400 dark:text-steel-500 font-semibold'},
    'mapped': {label: '● mapped', class: 'text-steel-600 dark:text-steel-300 font-bold'},
    'verified': {label: '✓ verified', class: 'text-success-700 dark:text-[#7fd0a0] font-bold'},
    'missing': {label: '⚠ missing', class: 'text-rose-700 dark:text-rose-300 font-bold'}
  } %}
  <span class="text-[12.5px] whitespace-nowrap {{ config[status].class }}">{{ config[status].label }}</span>
{% endmacro %}

{% macro button(text, kind='primary', type='submit', disabled=false) %}
  {% set classes = {
    'primary': 'bg-apple-600 hover:bg-apple-700 text-white',
    'secondary': 'bg-white hover:bg-steel-50 text-steel-600 border border-steel-300 dark:bg-steel-900 dark:border-steel-700 dark:text-steel-200',
    'danger': 'bg-white hover:bg-rose-50 text-rose-700 border border-rose-300 dark:bg-steel-900 dark:border-rose-800 dark:text-rose-300'
  } %}
  <button type="{{ type }}" {% if disabled %}disabled{% endif %} class="inline-flex items-center justify-center rounded-md px-4 py-2 text-[14px] font-semibold transition-colors disabled:opacity-50 disabled:cursor-not-allowed {{ classes[kind] }}">{{ text }}</button>
{% endmacro %}

{% macro dynamicFieldForm(fields, fieldsEndpoint, imageValuePartial=none) %}
  <div data-dynamic-field-form data-fields-endpoint="{{ fieldsEndpoint }}"
       {% if imageValuePartial %}data-image-value-partial="{{ imageValuePartial }}"{% endif %}>
    <div data-fields-list>
      {% for field in fields %}
        {{ _dynamicFieldRow(field, imageValuePartial) }}
      {% endfor %}
    </div>
    <button type="button" class="mt-3 text-[13px] font-semibold text-apple-700 dark:text-apple-300" data-add-field>+ Add Field</button>
  </div>
{% endmacro %}

{% macro _dynamicFieldRow(field, imageValuePartial) %}
  <div class="mb-3" data-field-row data-field-id="{{ field.id }}" data-field-key="{{ field.key }}" data-field-type="{{ field.type }}">
    <div class="flex items-center justify-between mb-1">
      <label class="text-[13px] font-semibold text-steel-600 dark:text-steel-300">{{ field.key }}</label>
      <div class="relative" data-field-menu>
        <button type="button" class="text-steel-400 hover:text-steel-600 text-[13px] px-1" data-field-menu-trigger>⋯</button>
        <div class="hidden absolute right-0 mt-1 bg-white dark:bg-steel-800 border border-steel-200 dark:border-steel-700 rounded-md shadow-sm text-[12.5px] z-10" data-field-menu-panel>
          <button type="button" class="block w-full text-left px-3 py-1.5 hover:bg-steel-50 dark:hover:bg-steel-700 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-transparent" data-field-move-up>Move Up</button>
          <button type="button" class="block w-full text-left px-3 py-1.5 hover:bg-steel-50 dark:hover:bg-steel-700 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-transparent" data-field-move-down>Move Down</button>
          <button type="button" class="block w-full text-left px-3 py-1.5 hover:bg-steel-50 dark:hover:bg-steel-700" data-field-edit>Edit</button>
          <button type="button" class="block w-full text-left px-3 py-1.5 text-rose-700 dark:text-rose-300 hover:bg-steel-50 dark:hover:bg-steel-700" data-field-delete>Delete</button>
        </div>
      </div>
    </div>
    <div data-field-value-slot>
      {% if field.type == 'text' %}
        <input type="text" class="w-full rounded-md border border-steel-300 dark:border-steel-700 bg-transparent px-2.5 py-1.5 text-[13px]" value="{{ field.value }}" data-field-value />
      {% elif field.type == 'number' %}
        <input type="number" class="w-full rounded-md border border-steel-300 dark:border-steel-700 bg-transparent px-2.5 py-1.5 text-[13px]" value="{{ field.value }}" data-field-value />
      {% elif field.type == 'boolean' %}
        <input type="checkbox" {{ 'checked' if field.value }} data-field-value />
      {% elif field.type == 'image' and imageValuePartial %}
        {% include imageValuePartial %}
      {% elif field.type == 'multiline' %}
        <textarea rows="4" class="w-full rounded-md border border-steel-300 dark:border-steel-700 bg-transparent px-2.5 py-1.5 text-[13px] resize-y" data-field-value>{{ field.value }}</textarea>
      {% endif %}
    </div>
  </div>
{% endmacro %}
