{% extends "layout.njk" %}
{% set section = "templates" %}
{% import "macros.njk" as ui %}
{% block content %}
  <h1 class="text-xl font-black tracking-tight mb-1">Silhouette &amp; Pose Templates</h1>
  <p class="text-[13.5px] text-steel-500 mb-6">
    Not scoped to one character — upload once, reused from Casting and View Generation by every character afterward.
  </p>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5">
    {% for item in items %}
      <a href="/templates/{{ item.template.slug }}" class="block rounded-lg border border-steel-200 dark:border-steel-800 bg-white dark:bg-steel-900 overflow-hidden hover:shadow-md transition-shadow">
        <div class="aspect-square placeholder-photo flex items-center justify-center">
          {% if item.template.filename %}
            <img src="/uploads/templates/{{ item.template.filename }}" class="max-h-full max-w-full object-contain" alt="{{ item.template.name }}" />
          {% else %}
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-steel-400">
              <circle cx="12" cy="6" r="3" /><path d="M6 21v-4a6 6 0 0 1 12 0v4" />
            </svg>
          {% endif %}
        </div>
        <div class="p-3">
          <div class="font-bold text-[13.5px] mb-1">{{ item.template.name }}</div>
          <div class="text-[12px] text-steel-500">used by {{ item.usageCount }} character{{ '' if item.usageCount == 1 else 's' }}</div>
        </div>
      </a>
    {% endfor %}

    <a href="/templates/new" class="flex flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed border-steel-300 dark:border-steel-700 aspect-[1/1.35] text-steel-500 hover:border-apple-400 hover:text-apple-700">
      <span class="text-2xl leading-none">+</span>
      <span class="text-[13px] font-semibold">Add template</span>
    </a>
  </div>
{% endblock %}
