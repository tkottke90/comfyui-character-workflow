{% set latest = doneGenerations[doneGenerations.length - 1] %}
{% set latestImage = imagesById[latest.imageId] %}
<div class="mb-4 relative rounded-lg overflow-hidden aspect-video">
  {{ ui.mediaThumb('/manual/' + session.id + '/assets/' + latestImage.filename, latestImage.kind, 'manual-generations') }}
</div>

{% if doneGenerations.length > 1 %}
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 items-start">
    {% for generation in doneGenerations %}
      {% if not loop.last %}
        {% set image = imagesById[generation.imageId] %}
        <div class="rounded-lg border border-steel-200 dark:border-steel-800 bg-white dark:bg-steel-900 overflow-hidden">
          {% if image.kind == 'audio' %}
            <div class="relative h-16 overflow-hidden">
              {{ ui.mediaThumb('/manual/' + session.id + '/assets/' + image.filename, image.kind, 'manual-generations') }}
            </div>
          {% else %}
            <div class="aspect-[3/4] relative overflow-hidden">
              {{ ui.mediaThumb('/manual/' + session.id + '/assets/' + image.filename, image.kind, 'manual-generations') }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
{% endif %}
