{% extends "layout.njk" %}
{% set section = "manual" %}
{% import "macros.njk" as ui %}
{% block content %}
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-black tracking-tight">Manual Generations</h1>
    <a href="/manual/new" class="inline-flex items-center rounded-md px-4 py-2 text-[14px] font-semibold bg-apple-600 hover:bg-apple-700 text-white">
      + New Workflow
    </a>
  </div>

  {% if sessions.length == 0 %}
    <div class="rounded-lg border border-dashed border-steel-300 dark:border-steel-700 p-10 text-center text-steel-500">
      No manual workflows yet — create one to get started.
    </div>
  {% else %}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {% for session in sessions %}
        <a href="/manual/{{ session.id }}" class="block rounded-lg border border-steel-200 dark:border-steel-800 bg-white dark:bg-steel-900 overflow-hidden hover:shadow-md transition-shadow p-4">
          <div class="font-bold text-[14.5px] mb-1">{{ session.workflowName }}</div>
          {% if session.description %}
            <p class="text-[13px] text-steel-500 mb-2 line-clamp-2">{{ session.description }}</p>
          {% endif %}
          <div class="flex items-center gap-2 text-[12px] text-steel-500 mb-2">
            <span>{{ session.images.length }} image{{ '' if session.images.length == 1 else 's' }}</span>
            <span>&middot;</span>
            <span>{{ session.sessionNotes.length }} note{{ '' if session.sessionNotes.length == 1 else 's' }}</span>
          </div>
          {{ ui.mono('updated ' ~ session.updatedAt.toISOString().slice(0, 16).replace('T', ' ')) }}
        </a>
      {% endfor %}
    </div>
  {% endif %}
{% endblock %}
