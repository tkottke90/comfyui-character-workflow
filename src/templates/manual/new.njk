{% extends "layout.njk" %}
{% set section = "manual" %}
{% import "macros.njk" as ui %}
{% block content %}
  {{ ui.crumbs([{label: 'Manual', href: '/manual'}, {label: 'New Workflow'}]) }}
  <h1 class="text-xl font-black tracking-tight mb-5">New Workflow</h1>

  <form method="post" action="/api/v1/manual?view=yes" class="max-w-sm">
    {% call ui.card() %}
      <label class="block text-[13px] font-semibold text-steel-600 dark:text-steel-300 mb-1.5" for="name">Name</label>
      <input id="name" name="name" type="text" required autofocus
        class="w-full rounded-md border border-steel-300 dark:border-steel-700 dark:bg-steel-800 px-3 py-2 text-[14px] mb-4"
        placeholder="e.g. ControlNet Testing" />
      <div class="flex justify-end gap-2">
        {{ ui.button('Create Workflow') }}
      </div>
    {% endcall %}
  </form>
{% endblock %}
