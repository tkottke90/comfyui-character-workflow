{% extends "layout.njk" %}
{% set section = "manual" %}
{% import "macros.njk" as ui %}
{% set workspaceTab = "configuration" %}
{% block content %}
  {{ ui.crumbs([{label: 'Manual', href: '/manual'}, {label: session.workflowName, href: '/manual/' + session.id}, {label: 'Workspace'}]) }}
  <h1 class="text-xl font-black tracking-tight mb-1">{{ session.workflowName }}</h1>
  {% include "partials/manual-workspace-subnav.njk" %}
  {% if session.workflowFile %}
    {% call ui.card('Assigned workflow') %}
      <p class="text-[13px] text-steel-500 mb-1">Workflow attached (<code>{{ session.workflowFile }}</code>).</p>
      {% if session.workflowSource %}
        <p class="text-[13px] text-steel-500 mb-1">{{ 'Uploaded' if session.workflowSource == 'upload' else 'Selected from library' }}</p>
      {% endif %}
      <p class="text-[13px] text-steel-500 mb-4">Updated {{ ui.mono(session.updatedAt.toISOString().slice(0, 16).replace('T', ' ')) }}</p>

      <details>
        <summary class="cursor-pointer text-[13px] font-semibold text-apple-700 dark:text-apple-300">Change workflow</summary>
        <div class="mt-4">
          {% include "partials/manual-workflow-form.njk" %}
        </div>
      </details>
    {% endcall %}
  {% else %}
    <p class="text-[13px] text-steel-500 mb-4">No workflow configured yet.</p>
    {% call ui.card('Set workflow') %}
      {% include "partials/manual-workflow-form.njk" %}
    {% endcall %}
  {% endif %}
{% endblock %}
