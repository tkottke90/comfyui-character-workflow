{% extends "layout.njk" %}
{% set section = "characters" %}
{% set subsection = "spec" %}
{% import "macros.njk" as ui %}
{% block content %}
  {{ ui.crumbs([{label: 'Characters', href: '/characters'}, {label: character.name, href: '/characters/' + character.slug}, {label: 'Spec Builder'}]) }}
  {% include "partials/character-subnav.njk" %}
  <h1 class="text-xl font-black tracking-tight mb-5">Specification</h1>

  <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-6">
    <form method="post" action="/characters/{{ character.slug }}/spec" data-character-name="{{ character.name }}">
      {% call ui.card() %}
        {% if character.identityBlockFrozen %}
          <p class="text-[13px] text-steel-500 mb-4">The identity block is frozen — attribute edits below no longer recompile it.</p>
        {% endif %}

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-5 gap-y-4 mb-5">
          {% set fields = [
            ['sex', 'Sex / presentation'], ['apparent_age', 'Apparent age'], ['ethnicity', 'Ethnicity / origin'],
            ['skin_tone', 'Skin tone'], ['face_shape', 'Face shape'], ['eyes', 'Eyes'],
            ['eyebrows', 'Eyebrows'], ['hair', 'Hair'], ['nose', 'Nose'],
            ['lips', 'Lips'], ['build', 'Build / body shape'], ['height_impression', 'Height impression'],
            ['base_clothing', 'Base clothing (anchor)']
          ] %}
          {% for key, label in fields %}
            <div>
              <label class="block text-[13px] font-semibold text-steel-600 dark:text-steel-300 mb-1" for="attr-{{ key }}">{{ label }}</label>
              {% if attributeSuggestions[key] and attributeSuggestions[key].length > 0 %}
                <div class="relative" data-autocomplete data-suggestions="{{ attributeSuggestions[key] | dump }}">
                  <input id="attr-{{ key }}" name="attributes[{{ key }}]" type="text" data-spec-field="{{ key }}"
                    value="{{ character.attributes[key] }}" autocomplete="off"
                    class="w-full rounded-md border border-steel-300 dark:border-steel-700 dark:bg-steel-800 pl-3 pr-8 py-2 text-[14px]" />
                  <button type="button" data-autocomplete-clear tabindex="-1"
                    class="hidden absolute right-2 top-1/2 -translate-y-1/2 text-steel-400 hover:text-steel-600 dark:hover:text-steel-200 text-[13px] leading-none px-1">✕</button>
                  <ul data-autocomplete-list
                    class="hidden absolute z-10 mt-1 w-full max-h-48 overflow-auto rounded-md border border-steel-300 dark:border-steel-700 bg-white dark:bg-steel-800 shadow-lg text-[13.5px]"></ul>
                </div>
              {% else %}
                <input id="attr-{{ key }}" name="attributes[{{ key }}]" type="text" data-spec-field="{{ key }}"
                  value="{{ character.attributes[key] }}"
                  class="w-full rounded-md border border-steel-300 dark:border-steel-700 dark:bg-steel-800 px-3 py-2 text-[14px]" />
              {% endif %}
            </div>
          {% endfor %}
        </div>

        <label class="block text-[13px] font-semibold text-steel-600 dark:text-steel-300 mb-1" for="body_template">Body template</label>
        <select id="body_template" name="body_template" class="w-full rounded-md border border-steel-300 dark:border-steel-700 dark:bg-steel-800 px-3 py-2 text-[14px] mb-5">
          <option value="">— none —</option>
          {% for template in templates %}
            <option value="{{ template.slug }}" {% if character.body_template == template.slug %}selected{% endif %}>{{ template.name }}</option>
          {% endfor %}
        </select>

        <label class="block text-[13px] font-semibold text-steel-600 dark:text-steel-300 mb-1" for="styleSlug">Style</label>
        <select id="styleSlug" name="styleSlug"
          class="w-full rounded-md border border-steel-300 dark:border-steel-700 dark:bg-steel-800 px-3 py-2 text-[14px] mb-2"
          {% if styles.length == 0 %}disabled{% endif %}>
          {% if styles.length == 0 %}
            <option value="" disabled selected>No Styles Available</option>
          {% else %}
            <option value="">— none, keep current values —</option>
            {% for s in styles %}
              <option value="{{ s.slug }}">{{ s.name }}</option>
            {% endfor %}
          {% endif %}
        </select>
        <p class="text-[12px] text-steel-500 mb-2">
          Selecting a style copies its checkpoint/sampler/scheduler/cfg/steps/art-style onto this character on save.
          Manage styles from the <a href="/styles" class="underline">Styles</a> page.
        </p>

        <div class="rounded-md border border-steel-200 dark:border-steel-700 bg-steel-50 dark:bg-steel-800/50 px-3 py-2.5 text-[13px] mb-5">
          <div class="font-semibold text-steel-600 dark:text-steel-300 mb-1">
            Current generation settings
            {% if character.styleSourceName %}<span class="font-normal text-steel-400">(from: {{ character.styleSourceName }})</span>{% endif %}
          </div>
          <div class="font-mono text-steel-600 dark:text-steel-300">
            {{ character.checkpoint }} · {{ character.sampler }} · {{ character.scheduler }} · {{ character.steps }} steps · cfg {{ character.cfg }}{% if character.style %} · {{ character.style }}{% endif %}
          </div>
        </div>

        <label class="flex items-center gap-2.5 mb-5">
          <input type="checkbox" name="useNameAsToken" data-use-name-token {% if character.useNameAsToken %}checked{% endif %} class="h-4 w-4 rounded accent-apple-600" />
          <span class="text-[14px]">
            Use name as identity token
            <span class="block text-[12.5px] text-steel-500">Biases toward a distinct face — becomes frozen prompt content once cast.</span>
          </span>
        </label>

        <label class="block text-[13px] font-semibold text-steel-600 dark:text-steel-300 mb-1" for="negativePrompt">Negative guards</label>
        {% if character.promptAdapter.negativeMode == 'suppressed' %}
          <p class="text-[12px] text-steel-500 mb-1">Not sent to ComfyUI with this prompt adapter (still stored here).</p>
        {% endif %}
        <textarea id="negativePrompt" name="negativePrompt" rows="3" data-spec-field="negativePrompt"
          class="w-full rounded-md border border-steel-300 dark:border-steel-700 dark:bg-steel-800 px-3 py-2 text-[13px] font-mono mb-5">{{ character.negativePrompt }}</textarea>

        <div class="border-t border-steel-200 dark:border-steel-800 pt-4 mb-5" data-prompt-adapter-fieldset>
          <h2 class="text-[13px] font-bold uppercase tracking-wider text-steel-500 mb-3">Prompt adapter</h2>
          <p class="text-[12px] text-steel-500 mb-3">
            Inherited from the applied Style — hand-edit here if needed. Pick a different Style above to change the family.
          </p>

          <input type="hidden" name="promptAdapter[presetId]" data-adapter-field="presetId" value="{{ character.promptAdapter.presetId }}" />

          <label class="block text-[13px] font-semibold text-steel-600 dark:text-steel-300 mb-1" for="leadTags">Lead tags</label>
          <input id="leadTags" name="promptAdapter[leadTags]" data-adapter-field="leadTags" data-spec-field="promptAdapterLeadTags" type="text"
            value="{{ character.promptAdapter.leadTags }}"
            class="w-full rounded-md border border-steel-300 dark:border-steel-700 dark:bg-steel-800 px-3 py-2 text-[14px] mb-3" />

          <label class="block text-[13px] font-semibold text-steel-600 dark:text-steel-300 mb-1" for="qualityTagsPositive">Quality tags (positive)</label>
          <input id="qualityTagsPositive" name="promptAdapter[qualityTagsPositive]" data-adapter-field="qualityTagsPositive" data-spec-field="promptAdapterQualityTagsPositive" type="text"
            value="{{ character.promptAdapter.qualityTagsPositive }}"
            class="w-full rounded-md border border-steel-300 dark:border-steel-700 dark:bg-steel-800 px-3 py-2 text-[14px] mb-3" />

          <label class="block text-[13px] font-semibold text-steel-600 dark:text-steel-300 mb-1" for="negativeMode">Negative mode</label>
          <select id="negativeMode" name="promptAdapter[negativeMode]" data-adapter-field="negativeMode" data-spec-field="promptAdapterNegativeMode"
            class="w-full rounded-md border border-steel-300 dark:border-steel-700 dark:bg-steel-800 px-3 py-2 text-[14px] mb-3">
            <option value="template" {% if character.promptAdapter.negativeMode == 'template' %}selected{% endif %}>Use negative prompt</option>
            <option value="suppressed" {% if character.promptAdapter.negativeMode == 'suppressed' %}selected{% endif %}>Suppress negative prompt</option>
          </select>

          <label class="block text-[13px] font-semibold text-steel-600 dark:text-steel-300 mb-1" for="qualityTagsNegative">Quality tags (negative)</label>
          <input id="qualityTagsNegative" name="promptAdapter[qualityTagsNegative]" data-adapter-field="qualityTagsNegative" data-spec-field="promptAdapterQualityTagsNegative" type="text"
            value="{{ character.promptAdapter.qualityTagsNegative }}"
            class="w-full rounded-md border border-steel-300 dark:border-steel-700 dark:bg-steel-800 px-3 py-2 text-[14px]" />
        </div>

        {{ ui.button('Save Character') }}
      {% endcall %}
    </form>

    <div class="flex flex-col gap-5">
      {% call ui.card('Distinguishing features') %}
        {% if character.distinguishingFeatures.length == 0 %}
          <p class="text-[13px] text-steel-400 mb-3">None recorded.</p>
        {% else %}
          <ul class="flex flex-col gap-2 mb-3">
            {% for feature in character.distinguishingFeatures %}
              <li class="flex items-start justify-between gap-2 text-[13.5px]">
                <span>{{ feature.text }} <span class="text-steel-400 italic">({{ feature.size }})</span></span>
                <form method="post" action="/characters/{{ character.slug }}/spec/features/{{ loop.index0 }}/delete">
                  <button type="submit" class="text-rose-600 hover:underline text-[12px]">remove</button>
                </form>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
        <form method="post" action="/characters/{{ character.slug }}/spec/features" class="flex flex-col gap-2">
          <input name="text" type="text" placeholder="e.g. Small keloid scar, right jawline, ~1cm"
            class="w-full rounded-md border border-steel-300 dark:border-steel-700 dark:bg-steel-800 px-3 py-2 text-[13.5px]" />
          <select name="size" class="w-full rounded-md border border-steel-300 dark:border-steel-700 dark:bg-steel-800 px-3 py-2 text-[13.5px]">
            <option value="easy">easy</option>
            <option value="medium" selected>medium</option>
            <option value="hard">hard</option>
          </select>
          <button type="submit" class="text-[13px] font-semibold text-apple-700 dark:text-apple-300 text-left hover:underline">+ Add feature</button>
        </form>
      {% endcall %}

      {% call ui.card('Identity block · live preview') %}
        <pre data-identity-preview class="whitespace-pre-wrap font-mono text-[12.5px] text-steel-600 dark:text-steel-300">{{ previewIdentityBlock }}</pre>
      {% endcall %}

      {% call ui.card('Final prompt preview') %}
        <div class="text-[11px] font-bold uppercase tracking-wider text-steel-400 mb-1">Positive</div>
        <pre data-prompt-preview-positive class="whitespace-pre-wrap font-mono text-[12.5px] text-steel-600 dark:text-steel-300 mb-3">{{ previewPositivePrompt }}</pre>
        <div class="text-[11px] font-bold uppercase tracking-wider text-steel-400 mb-1">Negative</div>
        <pre data-prompt-preview-negative class="whitespace-pre-wrap font-mono text-[12.5px] text-steel-600 dark:text-steel-300">{{ previewNegativePrompt }}</pre>
      {% endcall %}

      {% set manualItems = ['features_listed', 'features_verifiable'] %}
      {% call ui.card('Specification checklist') %}
        {% for item in checklistItems %}
          {% if item.id in manualItems %}
            <form method="post" action="/characters/{{ character.slug }}/spec/checklist" class="inline">
              {% for other in manualItems %}
                {% if other != item.id and checklist['specification.' + other] %}
                  <input type="hidden" name="checklist[{{ other }}]" value="on" />
                {% endif %}
              {% endfor %}
              <label class="flex items-start gap-2.5 py-1.5 text-[14px] cursor-pointer">
                <input type="checkbox" name="checklist[{{ item.id }}]" onchange="this.form.submit()"
                  {% if checklist['specification.' + item.id] %}checked{% endif %}
                  class="mt-0.5 h-4 w-4 shrink-0 rounded accent-apple-600" />
                <span>{{ item.label }}</span>
              </label>
            </form>
          {% else %}
            {{ ui.checkrow('_readonly', checklist['specification.' + item.id], item.label, true) }}
          {% endif %}
        {% endfor %}
      {% endcall %}
    </div>
  </div>
{% endblock %}
