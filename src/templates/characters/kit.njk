{% extends "layout.njk" %}
{% set section = "characters" %}
{% import "macros.njk" as ui %}
{% set manualItems = ['polish_before_fix', 'detail_closeups', 'loose_hair_alt'] %}
{% block content %}
  {{ ui.crumbs([{label: 'Characters', href: '/characters'}, {label: character.name, href: '/characters/' + character.slug}, {label: 'Anchor Kit'}]) }}
  <div class="flex items-center gap-3 mb-5">
    <h1 class="text-xl font-black tracking-tight">Anchor Kit</h1>
    {{ ui.statusBadge(character.status) }}
  </div>

  <div class="flex items-center gap-4 mb-6">
    <a href="/characters/{{ character.slug }}/kit/face-crop" class="text-[13.5px] font-semibold text-apple-700 dark:text-apple-300 hover:underline">Face Crop →</a>
    <a href="/characters/{{ character.slug }}/kit/views" class="text-[13.5px] font-semibold text-apple-700 dark:text-apple-300 hover:underline">View Generation →</a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-6">
    <div class="flex flex-col gap-5">
      {% call ui.card('Images') %}
        {% if character.images.length == 0 %}
          <p class="text-[13.5px] text-steel-400 mb-4">No assets recorded yet.</p>
        {% else %}
          <table class="w-full text-[13px] mb-4">
            <thead>
              <tr class="text-left text-steel-500 border-b border-steel-200 dark:border-steel-800">
                <th class="py-1.5 pr-3 font-semibold">Asset</th>
                <th class="py-1.5 pr-3 font-semibold">Path</th>
                <th class="py-1.5 font-semibold">Notes</th>
              </tr>
            </thead>
            <tbody>
              {% for image in character.images %}
                <tr class="border-b border-steel-100 dark:border-steel-800 last:border-0">
                  <td class="py-1.5 pr-3 font-semibold">{{ image.label }}</td>
                  <td class="py-1.5 pr-3 font-mono text-steel-500">{{ image.path or '—' }}</td>
                  <td class="py-1.5 text-steel-500">{{ image.notes or '—' }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% endif %}

        <form method="post" action="/characters/{{ character.slug }}/kit/images" class="grid grid-cols-1 sm:grid-cols-3 gap-2">
          <input name="label" placeholder="Asset label (e.g. Hero full-body)" required
            class="rounded-md border border-steel-300 dark:border-steel-700 dark:bg-steel-800 px-2.5 py-1.5 text-[13px]" />
          <input name="path" placeholder="Path or URL"
            class="rounded-md border border-steel-300 dark:border-steel-700 dark:bg-steel-800 px-2.5 py-1.5 text-[13px]" />
          <div class="flex gap-2">
            <input name="notes" placeholder="Notes"
              class="flex-1 rounded-md border border-steel-300 dark:border-steel-700 dark:bg-steel-800 px-2.5 py-1.5 text-[13px]" />
            <button type="submit" class="rounded-md px-3 py-1.5 text-[13px] font-semibold bg-apple-600 hover:bg-apple-700 text-white">Save</button>
          </div>
        </form>
      {% endcall %}
    </div>

    <div class="flex flex-col gap-5">
      {% call ui.card('Anchor kit checklist') %}
        {% for item in items %}
          {% if item.id in manualItems %}
            <form method="post" action="/characters/{{ character.slug }}/kit/checklist" class="inline">
              {% for other in manualItems %}
                {% if other != item.id and checklist['anchorKit.' + other] %}
                  <input type="hidden" name="checklist[{{ other }}]" value="on" />
                {% endif %}
              {% endfor %}
              <label class="flex items-start gap-2.5 py-1.5 text-[14px] cursor-pointer">
                <input type="checkbox" name="checklist[{{ item.id }}]" onchange="this.form.submit()"
                  {% if checklist['anchorKit.' + item.id] %}checked{% endif %}
                  class="mt-0.5 h-4 w-4 shrink-0 rounded accent-apple-600" />
                <span>{{ item.label }}</span>
              </label>
            </form>
          {% else %}
            {{ ui.checkrow('_readonly', checklist['anchorKit.' + item.id], item.label, true) }}
          {% endif %}
        {% endfor %}
      {% endcall %}
    </div>
  </div>
{% endblock %}
