{% extends "layout.njk" %}
{% set section = "characters" %}
{% set subsection = "casting-batch" %}
{% import "macros.njk" as ui %}
{% block content %}
  {{ ui.crumbs([{label: 'Characters', href: '/characters'}, {label: character.name, href: '/characters/' + character.slug}, {label: 'Winner Audit'}]) }}
  {% include "partials/character-subnav.njk" %}
  <div class="flex items-center gap-3 mb-1">
    <h1 class="text-xl font-black tracking-tight">Winner Audit</h1>
    {{ ui.statusBadge(character.status) }}
  </div>
  {% if character.winnerCandidateSeed %}
    <div class="mb-5">{{ ui.mono('candidate · seed ' + character.winnerCandidateSeed) }}</div>
  {% endif %}

  <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] gap-6">
    {% if winner and winner.imagePath %}
      <img src="/characters/{{ character.slug }}/images/file/{{ winner.imagePath }}"
        class="aspect-[3/4] max-h-[440px] w-full object-cover rounded-lg" alt="" />
    {% else %}
      <div class="aspect-[3/4] max-h-[440px] placeholder-photo rounded-lg"></div>
    {% endif %}

    {% call ui.card('Attribute-by-attribute vs. spec') %}
      <div class="flex flex-col gap-3">
        {% for row in rows %}
          <div class="flex flex-col gap-2 pb-3 border-b border-steel-100 dark:border-steel-800 last:border-0">
            <div class="flex items-start gap-3">
              <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full mt-1 {{ 'bg-success-600' if row.ok else 'bg-rose-600' }}">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3">
                  {% if row.ok %}<path d="M20 6 9 17l-5-5" />{% else %}<path d="M18 6 6 18M6 6l12 12" />{% endif %}
                </svg>
              </span>
              <div class="flex-1">
                <div class="text-[13.5px] font-semibold mb-0.5">{{ row.attribute }}</div>
                <div class="text-[13px] text-steel-500">{{ row.specValue }}</div>
              </div>
              <form method="post" action="/characters/{{ character.slug }}/casting/audit-rows/{{ loop.index0 }}/toggle" class="shrink-0">
                <button type="submit" class="text-[12px] font-semibold {{ 'text-rose-700 dark:text-rose-300' if row.ok else 'text-apple-700 dark:text-apple-300' }} hover:underline">
                  {{ 'Flag mismatch' if row.ok else 'Mark as OK' }}
                </button>
              </form>
            </div>

            {% if not row.ok %}
              <div class="ml-7 flex flex-wrap items-center gap-3">
                <form method="post" action="/characters/{{ character.slug }}/casting/audit-rows/{{ loop.index0 }}/amend" class="flex items-center gap-2">
                  <input name="specValue" value="{{ row.specValue }}"
                    class="rounded-md border border-steel-300 dark:border-steel-700 dark:bg-steel-800 px-2.5 py-1.5 text-[13px]" />
                  <button type="submit" class="text-[12px] font-semibold text-apple-700 dark:text-apple-300 hover:underline">Amend spec to match image</button>
                </form>
                {% if character.winnerCandidateSeed %}
                  <form method="post" action="/characters/{{ character.slug }}/casting/candidates/{{ character.winnerCandidateSeed }}/reject"
                    onsubmit="return confirm('Reject this candidate? This deletes it and clears the winner audit. This cannot be undone.');">
                    <button type="submit" class="text-[12px] font-semibold text-rose-700 dark:text-rose-300 hover:underline">Reject candidate</button>
                  </form>
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endcall %}
  </div>

  <form method="post" action="/characters/{{ character.slug }}/casting/lock" class="mt-5">
    {{ ui.button('Lock This Seed') }}
    {% if rows | rejectattr('ok') | list | length > 0 %}
      <p class="text-[13px] text-rose-600 mt-2">Resolve the flagged attribute above to continue.</p>
    {% elif not character.winnerCandidateSeed %}
      <p class="text-[13px] text-steel-500 mt-2">Select a winning candidate from the Casting Batch first.</p>
    {% endif %}
  </form>
{% endblock %}
