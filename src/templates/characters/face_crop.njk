{% extends "layout.njk" %}
{% set section = "characters" %}
{% import "macros.njk" as ui %}
{% block content %}
  {{ ui.crumbs([{label: 'Characters', href: '/characters'}, {label: character.name, href: '/characters/' + character.slug}, {label: 'Face Crop'}]) }}
  <div class="flex items-center gap-3 mb-5">
    <h1 class="text-xl font-black tracking-tight">Face Crop</h1>
    {{ ui.statusBadge(character.status) }}
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-6">
    <div class="aspect-square max-w-md placeholder-photo rounded-lg flex items-center justify-center text-steel-400 text-[12px]">
      detector suggestion — drag to adjust in your editor of choice, then paste the crop path below
    </div>

    <form method="post" action="/characters/{{ character.slug }}/kit/face-crop">
      {% call ui.card('Crop') %}
        <label class="block text-[13px] font-semibold text-steel-600 dark:text-steel-300 mb-1" for="path">Crop file path</label>
        <input id="path" name="path" type="text" value="{{ character.faceCrop.path }}"
          class="w-full rounded-md border border-steel-300 dark:border-steel-700 dark:bg-steel-800 px-3 py-2 text-[13.5px] font-mono mb-4" />

        <label class="flex items-center gap-2.5 mb-4">
          <input type="checkbox" name="confirmed" {% if character.faceCrop.confirmed %}checked{% endif %} class="h-4 w-4 rounded accent-apple-600" />
          <span class="text-[14px]">Confirm crop</span>
        </label>

        {{ ui.button('Save Crop') }}
        <p class="text-[12.5px] text-steel-500 mt-3">
          This crop becomes the only image any later screen can use as a face reference — never the full-body hero.
        </p>
      {% endcall %}
    </form>
  </div>
{% endblock %}
