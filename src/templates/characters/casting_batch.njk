{% extends "layout.njk" %}
{% set section = "characters" %}
{% set subsection = "casting-batch" %}
{% import "macros.njk" as ui %}
{% block content %}
  {{ ui.crumbs([{label: 'Characters', href: '/characters'}, {label: character.name, href: '/characters/' + character.slug}, {label: 'Casting Batch'}]) }}
  {% include "partials/character-subnav.njk" %}
  <div class="flex items-center justify-between mb-5">
    <div class="flex items-center gap-3">
      <h1 class="text-xl font-black tracking-tight">Casting — Batch</h1>
      {{ ui.statusBadge(character.status) }}
    </div>
    {{ ui.mono(character.castingCandidates.length ~ ' candidates') }}
  </div>

  <form method="post" action="/characters/{{ character.slug }}/casting/batch/candidates" class="mb-6">
    {% call ui.card() %}
      <div class="flex items-end gap-3 flex-wrap">
        <div>
          <label class="block text-[13px] font-semibold text-steel-600 dark:text-steel-300 mb-1" for="startSeed">Starting seed</label>
          <div class="flex items-center gap-2">
            <input id="startSeed" name="startSeed" type="number" required
              class="rounded-md border border-steel-300 dark:border-steel-700 dark:bg-steel-800 px-3 py-2 text-[14px] font-mono w-48" />
            <span data-randomize-seed="startSeed">
              {{ ui.button('Randomize', 'secondary', 'button') }}
            </span>
          </div>
        </div>
        <div>
          <label class="block text-[13px] font-semibold text-steel-600 dark:text-steel-300 mb-1" for="count">Count (8–16)</label>
          <input id="count" name="count" type="number" min="1" max="16" value="8"
            class="rounded-md border border-steel-300 dark:border-steel-700 dark:bg-steel-800 px-3 py-2 text-[14px] w-28" />
        </div>
        {{ ui.button('Running…' if jobActive else 'Queue Candidates', 'primary', 'submit', jobActive) }}
      </div>
      <p class="text-[12.5px] text-steel-500 mt-3">
        Each candidate is a separate request with its own literal seed — never a shared batch latent.
      </p>
    {% endcall %}
  </form>

  {% if character.castingCandidates.length == 0 %}
    <div class="rounded-lg border border-dashed border-steel-300 dark:border-steel-700 p-8 text-center text-steel-500">
      No candidates queued yet.
    </div>
  {% else %}
    <!-- data-sse-batch (as opposed to data-sse-events alone) tells sse-client.js to patch
         individual [data-casting-tile] elements by seed rather than reload the page — this
         is the one page the design calls out as needing real per-tile live progress. -->
    <div data-sse-events="/characters/{{ character.slug }}/events/casting_batch" data-sse-batch
      data-images-base="/characters/{{ character.slug }}/images/file">
      <div class="text-[12.5px] text-steel-500 mb-3" data-sse-status></div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        {% for candidate in character.castingCandidates %}
          <div class="rounded-lg border border-steel-200 dark:border-steel-800 bg-white dark:bg-steel-900 overflow-hidden" data-casting-tile data-seed="{{ candidate.seed }}">
            <div class="aspect-[3/4] relative overflow-hidden">
              {% if candidate.imagePath %}
                <img src="/characters/{{ character.slug }}/images/file/{{ candidate.imagePath }}" data-tile-image
                  data-viewer-trigger data-viewer-group="casting-batch" class="absolute inset-0 w-full h-full object-cover" alt="" />
              {% else %}
                <div class="placeholder-photo absolute inset-0" data-tile-placeholder></div>
              {% endif %}
              <div class="absolute bottom-0 inset-x-0 bg-black/60 text-white text-[11px] px-2 py-1" data-tile-status></div>
            </div>
            <div class="p-2.5">
              {{ ui.mono('seed ' + candidate.seed) }}
              {% if character.winnerCandidateSeed == candidate.seed %}
                <div class="mt-1">{{ ui.pill('winner', 'green') }}</div>
              {% else %}
                <form method="post" action="/characters/{{ character.slug }}/casting/candidates/{{ candidate.seed }}/select" class="mt-1.5">
                  <button type="submit" class="text-[12px] font-semibold text-apple-700 dark:text-apple-300 hover:underline">Select as winner</button>
                </form>
                <span data-tile-delete class="{{ '' if candidate.imagePath else 'hidden' }}">
                  <form method="post" action="/characters/{{ character.slug }}/casting/candidates/{{ candidate.seed }}/delete"
                    onsubmit="return confirm('Delete this candidate? This cannot be undone.');" class="mt-1">
                    <button type="submit" class="text-[12px] font-semibold text-rose-700 dark:text-rose-300 hover:underline">Delete</button>
                  </form>
                </span>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% if character.winnerCandidateSeed %}
    <div class="mt-5">
      <a href="/characters/{{ character.slug }}/casting/winner-audit" class="text-[14px] font-semibold text-apple-700 dark:text-apple-300 hover:underline">Continue to Winner Audit →</a>
    </div>
  {% endif %}
{% endblock %}
