{% extends "layout.njk" %}
{% set section = "characters" %}
{% set subsection = "casting" %}
{% import "macros.njk" as ui %}
{% block content %}
  {{ ui.crumbs([{label: 'Characters', href: '/characters'}, {label: character.name, href: '/characters/' + character.slug}, {label: 'Casting'}]) }}
  {% include "partials/character-subnav.njk" %}
  <div class="flex items-center gap-3 mb-5">
    <h1 class="text-xl font-black tracking-tight">Casting — Pre-flight</h1>
    {{ ui.statusBadge(character.status) }}
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-6">
    <div>
      <div data-sse-events="/characters/{{ character.slug }}/events/{{ phaseBindingKey }}"
        data-initial-status="{{ job.status if job else '' }}"
        class="aspect-[2/3] max-h-[520px] rounded-lg border border-apple-300 relative overflow-hidden">
        {% if job and job.kind == 'single' and job.status == 'done' and job.resultPath %}
          <img src="/characters/{{ character.slug }}/images/file/{{ job.resultPath }}" class="absolute inset-0 w-full h-full object-cover" alt="" />
        {% else %}
          <div class="placeholder-photo absolute inset-0 flex items-end justify-center p-3">
            {% if character.locked_seed %}{{ ui.mono('seed ' + character.locked_seed + ' · locked') }}{% endif %}
          </div>
        {% endif %}
        <div class="absolute bottom-0 inset-x-0 bg-black/60 text-white text-[12px] px-2 py-1" data-sse-status></div>
        <progress data-sse-progress class="hidden w-full h-1" max="100" value="0"></progress>
      </div>

      {% if job and job.kind == 'single' and job.status == 'error' and job.error %}
        <div class="mt-2 rounded-md border border-rose-300 bg-rose-50 dark:bg-rose-950 dark:border-rose-800 px-3 py-2 text-[12.5px] text-rose-800 dark:text-rose-300">
          {% if job.error.kind == 'connection' %}
            Lost the connection to ComfyUI mid-run: {{ job.error.message }}
            <a href="/integration/connection" class="block mt-1 font-semibold underline">Check Connection →</a>
          {% else %}
            {{ job.error.message }}
          {% endif %}
        </div>
      {% endif %}

      <form method="post" action="/characters/{{ character.slug }}/run/{{ phaseBindingKey }}" class="mt-3 flex items-end gap-3">
        <div>
          <label class="block text-[13px] font-semibold text-steel-600 dark:text-steel-300 mb-1" for="castingSeed">Seed (fixed for pre-flight)</label>
          <div class="flex items-center gap-2">
            <input id="castingSeed" name="castingSeed" type="number" required
              class="rounded-md border border-steel-300 dark:border-steel-700 dark:bg-steel-800 px-3 py-2 text-[14px] font-mono w-40" />
            <span data-randomize-seed="castingSeed">
              {{ ui.button('Randomize', 'secondary', 'button') }}
            </span>
          </div>
        </div>
        {{ ui.button('Running…' if jobActive else 'Run Pre-flight', 'primary', 'submit', jobActive) }}
      </form>
      <p class="text-[12px] text-steel-500 mt-1">Re-run on the same seed after each fix — only noise (the seed) should vary once you move to the batch.</p>
    </div>

    <form method="post" action="/characters/{{ character.slug }}/casting/preflight">
      {% call ui.card() %}
        <div class="mb-4">
          {% for item in items %}
            {{ ui.checkrow('checklist[' + item.id + ']', checklist['preflight.' + item.id], item.label) }}
          {% endfor %}
        </div>

        <label class="block text-[13px] font-semibold text-steel-600 dark:text-steel-300 mb-1" for="heroPath">Control image path / seed note</label>
        <input id="heroPath" name="heroPath" type="text" value="{{ heroPath }}"
          class="w-full rounded-md border border-steel-300 dark:border-steel-700 dark:bg-steel-800 px-3 py-2 text-[13.5px] mb-4" />

        <div class="flex items-center justify-between text-[13.5px] mb-4">
          <span class="font-semibold text-steel-600 dark:text-steel-300">Batch size</span>
          {{ ui.mono('8–16 candidates') }}
        </div>

        {{ ui.button('Save Pre-flight') }}
      {% endcall %}
    </form>
  </div>

  <div class="mt-5">
    <a href="/characters/{{ character.slug }}/casting/batch" class="text-[14px] font-semibold text-apple-700 dark:text-apple-300 hover:underline">Continue to Casting Batch →</a>
  </div>
{% endblock %}
