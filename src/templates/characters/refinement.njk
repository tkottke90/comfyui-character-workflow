{% extends "layout.njk" %}
{% set section = "characters" %}
{% set subsection = "refinement" %}
{% import "macros.njk" as ui %}
{% block content %}
  {{ ui.crumbs([{label: 'Characters', href: '/characters'}, {label: character.name, href: '/characters/' + character.slug}, {label: 'Refinement'}]) }}
  {% include "partials/character-subnav.njk" %}
  <div class="flex items-center gap-3 mb-5">
    <h1 class="text-xl font-black tracking-tight">Refinement Chain</h1>
    {{ ui.statusBadge(character.status) }}
  </div>

  <div class="flex items-center gap-4 mb-6">
    {% set steps = [[1, 'Face detail'], [2, 'Cleanup'], [3, 'Upscale']] %}
    {% for num, label in steps %}
      <div class="flex items-center gap-2">
        <span class="flex h-6 w-6 items-center justify-center rounded-full text-[12px] font-bold
          {{ 'bg-apple-600 text-white' if num <= character.refinement.currentStep else 'bg-steel-100 text-steel-500 dark:bg-steel-800' }}">
          {% if num < character.refinement.currentStep %}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5" /></svg>
          {% else %}{{ num }}{% endif %}
        </span>
        <span class="text-[13.5px] font-semibold">{{ label }}</span>
      </div>
      {% if not loop.last %}<div class="w-8 h-px bg-steel-300 dark:bg-steel-700"></div>{% endif %}
    {% endfor %}
  </div>

  <!-- Each grid cell below is its own independent <form> — nesting a <form> for image/mask
       upload and run-triggering inside the parameters form (as one giant page-wide form,
       the layout this replaced) isn't valid HTML, so these are kept as siblings instead. -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mb-6">
    <div>
      <div class="text-[11.5px] font-bold uppercase tracking-wider text-steel-500 mb-2">Input</div>
      <div data-file-upload>
        <form method="post" action="/characters/{{ character.slug }}/images/{{ phaseBindingKey }}">
          <input type="hidden" name="dataUrl" value="" />
          <input type="hidden" name="kind" value="image" />
          <div data-viewer-tile class="relative aspect-[3/4] rounded-lg border-2 border-dashed border-steel-300 dark:border-steel-700 overflow-hidden cursor-pointer mb-2"
            onclick="this.parentElement.querySelector('input[type=file]').click()">
            <img {% if currentImage %}src="/characters/{{ character.slug }}/images/file/{{ currentImage.relativePath }}"{% endif %}
              data-file-preview class="{{ '' if currentImage else 'hidden' }} absolute inset-0 w-full h-full object-cover" alt="" />
            <div class="absolute inset-0 flex items-center justify-center text-center p-3 text-[13px] font-semibold text-steel-500" data-file-label>
              {{ '' if currentImage else 'Drag an image here, or click to browse' }}
            </div>
            {% if currentImage %}
              <button type="button" data-viewer-trigger data-viewer-checklist="refinement-checklist-panel" aria-label="Enlarge image"
                class="absolute top-1 right-1 z-10 inline-flex items-center justify-center w-7 h-7 rounded bg-black/50 text-white hover:bg-black/70">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" /></svg>
              </button>
            {% endif %}
          </div>
          <input type="file" accept="image/png,image/jpeg,image/webp" class="hidden" />
          {{ ui.button('Save as current image', 'secondary') }}
        </form>
      </div>

      {% if libraryCandidates.length > 0 %}
        <div class="mt-2">
          <button type="button" data-picker-toggle class="text-[12.5px] font-semibold text-apple-700 dark:text-apple-300 hover:underline">Choose from library</button>
          <div data-picker-panel data-highlight="{{ highlightRelativePath or '' }}" class="hidden mt-2 grid grid-cols-3 gap-2">
            {% for candidate in libraryCandidates %}
              <form method="post" action="/characters/{{ character.slug }}/images/{{ phaseBindingKey }}/promote" data-picker-tile data-relative-path="{{ candidate.relativePath }}" class="relative">
                <input type="hidden" name="sourceRelativePath" value="{{ candidate.relativePath }}" />
                <button type="submit" class="block w-full aspect-square rounded-md overflow-hidden border border-steel-300 dark:border-steel-700">
                  {% if candidate.source.kind == 'finalized' %}
                    <img src="/characters/{{ character.slug }}/images/finalized/{{ candidate.filename }}" class="w-full h-full object-cover" alt="" />
                  {% else %}
                    <img src="/characters/{{ character.slug }}/images/file/{{ candidate.relativePath }}" class="w-full h-full object-cover" alt="" />
                  {% endif %}
                </button>
                <button type="button" data-viewer-trigger data-viewer-group="refinement-picker" aria-label="Enlarge image"
                  class="absolute top-1 left-1 z-10 inline-flex items-center justify-center w-6 h-6 rounded bg-black/50 text-white hover:bg-black/70">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" /></svg>
                </button>
              </form>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>

    <div>
      <div class="text-[11.5px] font-bold uppercase tracking-wider text-apple-700 dark:text-apple-300 mb-2">Output preview</div>
      <div data-sse-events="/characters/{{ character.slug }}/events/{{ phaseBindingKey }}" data-initial-status="{{ job.status if job else '' }}" class="aspect-[3/4] rounded-lg border border-apple-300 relative overflow-hidden">
        {% if job and job.kind == 'single' and job.status == 'done' and job.resultPath %}
          <img src="/characters/{{ character.slug }}/images/file/{{ job.resultPath }}"
            data-viewer-trigger data-viewer-checklist="refinement-checklist-panel" class="absolute inset-0 w-full h-full object-cover" alt="" />
        {% else %}
          <div class="placeholder-photo absolute inset-0"></div>
        {% endif %}
        <div class="absolute bottom-0 inset-x-0 bg-black/60 text-white text-[12px] px-2 py-1" data-sse-status></div>
        <progress data-sse-progress class="hidden w-full h-1" max="100" value="0"></progress>
      </div>

      {% if job and job.kind == 'single' and job.status == 'error' and job.error %}
        <div class="mt-2 rounded-md border border-rose-300 bg-rose-50 dark:bg-rose-950 dark:border-rose-800 px-3 py-2 text-[12.5px] text-rose-800 dark:text-rose-300">
          {% if job.error.kind == 'connection' %}
            Lost the connection to ComfyUI mid-run: {{ job.error.message }}
            <a href="/integration/connection" class="block mt-1 font-semibold underline">Check Connection →</a>
          {% else %}
            {{ job.error.message }}
          {% endif %}
        </div>
      {% endif %}

      <form method="post" action="/characters/{{ character.slug }}/run/{{ phaseBindingKey }}" class="mt-2">
        {% if phaseBindingKey == 'refinement_cleanup' %}
          <p class="text-[12px] text-steel-500 mb-2">The character's global identity block/negative prompt has little to do with a background/artifact cleanup pass — use these to supply fresh text for this run instead.</p>
          <label class="block text-[13px] font-semibold text-steel-600 dark:text-steel-300 mb-1" for="customPositivePrompt">Positive prompt</label>
          <textarea id="customPositivePrompt" name="customPositivePrompt" rows="3"
            class="w-full rounded-md border border-steel-300 dark:border-steel-700 dark:bg-steel-800 px-3 py-2 text-[14px] mb-3"
            placeholder="What should replace the cleaned-up area…"></textarea>

          <label class="block text-[13px] font-semibold text-steel-600 dark:text-steel-300 mb-1" for="customNegativePrompt">Negative prompt</label>
          <textarea id="customNegativePrompt" name="customNegativePrompt" rows="3"
            class="w-full rounded-md border border-steel-300 dark:border-steel-700 dark:bg-steel-800 px-3 py-2 text-[14px] mb-3"
            placeholder="What to avoid in the cleaned-up area…"></textarea>
        {% endif %}
        {{ ui.button('Running…' if jobActive else 'Run', 'primary', 'submit', jobActive or not currentImage) }}
      </form>
      {% if not currentImage %}
        <p class="text-[12px] text-steel-500 mt-1">Save a current image before running this step.</p>
      {% endif %}
    </div>

    <form method="post" action="/characters/{{ character.slug }}/refinement">
      {% call ui.card() %}
        <label class="block text-[13px] font-semibold text-steel-600 dark:text-steel-300 mb-1" for="faceDetailDenoise">Face detail denoise</label>
        <input id="faceDetailDenoise" name="faceDetailDenoise" type="range" min="0.2" max="0.6" step="0.01"
          value="{{ character.refinement.faceDetailDenoise }}" data-range-output="#faceDetailReadout"
          class="w-full mb-1 accent-apple-600" />
        <div id="faceDetailReadout" class="font-mono text-[13px] text-steel-500 mb-4"></div>

        <label class="block text-[13px] font-semibold text-steel-600 dark:text-steel-300 mb-1" for="cleanupDenoise">Cleanup denoise</label>
        <input id="cleanupDenoise" name="cleanupDenoise" type="range" min="0.2" max="0.45" step="0.01"
          value="{{ character.refinement.cleanupDenoise }}" data-range-output="#cleanupReadout"
          class="w-full mb-1 accent-apple-600" />
        <div id="cleanupReadout" class="font-mono text-[13px] text-steel-500 mb-4"></div>

        <label class="block text-[13px] font-semibold text-steel-600 dark:text-steel-300 mb-1" for="upscaleTarget">Upscale target (px, long edge)</label>
        <input id="upscaleTarget" name="upscaleTarget" type="number" min="1024" step="128"
          value="{{ character.refinement.upscaleTarget }}"
          class="w-full rounded-md border border-steel-300 dark:border-steel-700 dark:bg-steel-800 px-3 py-2 text-[14px] mb-4" />

        <label class="block text-[13px] font-semibold text-steel-600 dark:text-steel-300 mb-1" for="currentStep">Current step</label>
        <select id="currentStep" name="currentStep" class="w-full rounded-md border border-steel-300 dark:border-steel-700 dark:bg-steel-800 px-3 py-2 text-[14px] mb-4">
          <option value="1" {% if character.refinement.currentStep == 1 %}selected{% endif %}>1 · Face detail</option>
          <option value="2" {% if character.refinement.currentStep == 2 %}selected{% endif %}>2 · Cleanup</option>
          <option value="3" {% if character.refinement.currentStep == 3 %}selected{% endif %}>3 · Upscale</option>
        </select>

        {{ ui.button('Accept & Continue') }}
      {% endcall %}
    </form>
  </div>

  {% if phaseBindingKey == 'refinement_cleanup' %}
    {% call ui.card('Current Mask') %}
      <p class="text-[13px] text-steel-500 mb-3">Painted white on black — used as the inpaint mask for this step (SetLatentNoiseMask.mask). Draw a polygon over the current image, or upload a mask that already matches its exact pixel dimensions.</p>
      {% if currentImage %}
        <form method="post" action="/characters/{{ character.slug }}/images/{{ phaseBindingKey }}">
          <input type="hidden" name="kind" value="mask" />
          <div data-mask-editor data-image-src="/characters/{{ character.slug }}/images/file/{{ currentImage.relativePath }}">
            <div class="flex items-center gap-2 mb-2">
              <button type="button" data-mask-mode-btn="draw" class="rounded-md border border-steel-300 dark:border-steel-700 px-3 py-1 text-[12.5px] font-semibold">Draw</button>
              <button type="button" data-mask-mode-btn="upload" class="rounded-md border border-steel-300 dark:border-steel-700 px-3 py-1 text-[12.5px] font-semibold">Upload</button>
            </div>
            <canvas data-mask-canvas class="max-w-full rounded-lg border border-steel-300 dark:border-steel-700 mb-2"></canvas>
            <div data-mask-draw-tools class="flex items-center gap-2 mb-2">
              <button type="button" data-mask-add-vertex class="text-[12.5px] font-semibold text-apple-700 dark:text-apple-300 hover:underline">Add vertex</button>
              <button type="button" data-mask-remove-vertex class="text-[12.5px] font-semibold text-rose-700 dark:text-rose-300 hover:underline">Remove vertex</button>
            </div>
            <div data-mask-upload-tools class="mb-2 hidden">
              <input type="file" accept="image/png,image/jpeg,image/webp" data-mask-upload-input class="text-[13px]" />
            </div>
            <input type="hidden" name="maskMode" data-mask-mode value="draw" />
            <input type="hidden" name="dataUrl" data-mask-data-url />
          </div>
          {% if currentMask %}
            <p class="text-[12px] text-steel-500 mt-2 mb-2">A mask is already saved for this step — saving again adds a new version.</p>
          {% endif %}
          {{ ui.button('Save as current mask', 'secondary') }}
        </form>
      {% else %}
        <p class="text-[13px] text-steel-500">Save a current image above first — the mask editor needs it as a reference.</p>
      {% endif %}
    {% endcall %}
  {% endif %}

  <form method="post" action="/characters/{{ character.slug }}/refinement" class="mt-6"
    id="refinement-checklist-panel" data-checklist-phase="refinement" data-viewer-ajax-form>
    {% call ui.card('Checklist') %}
      {% for item in items %}
        {{ ui.checkrow('checklist[' + item.id + ']', checklist['refinement.' + item.id], item.label) }}
      {% endfor %}
      <div class="mt-3">{{ ui.button('Save checklist', 'secondary') }}</div>
    {% endcall %}
  </form>
{% endblock %}
